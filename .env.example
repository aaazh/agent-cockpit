PORT=3334
# Bind to loopback behind an authenticated reverse proxy or SSH tunnel.
HOST=127.0.0.1
# No local chat runtimes, MCP servers, schedulers or model login in this mode.
MONITOR_ONLY=false
# Root URL only; HTTPS or loopback HTTP. Keep the read-only token server-side.
EXTERNAL_SESSION_SOURCE_URL=
EXTERNAL_SESSION_SOURCE_TOKEN=
# This Fork uses its own release feed. Monitoring mode disables self-update.
UPDATE_REPOSITORY=aaazh/agent-cockpit
SESSION_SECRET=replace-with-a-long-random-string
AUTH_DATA_DIR=
AUTH_SETUP_TOKEN=
AUTH_ENABLE_LEGACY_OAUTH=false
# Legacy OAuth only; not required for the default first-party owner login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
ALLOWED_EMAIL=
DEFAULT_WORKSPACE=~/.agent-cockpit/workspace
BASE_PATH=
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX_MODE=workspace-write
# auto builds stale/missing /v2 and /mobile assets at startup; skip is for tests/special deployments.
WEB_BUILD_MODE=auto
